# Copy to .env and paste values from Firebase Console → Project settings → Your apps → Web app config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: PIN to edit gallery and couple sections on the site (leave empty to allow editing without a PIN)
VITE_SITE_EDIT_PIN=

# Legacy alias — used if VITE_SITE_EDIT_PIN is not set
VITE_GALLERY_EDIT_PIN=
